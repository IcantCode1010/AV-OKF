generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMember[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id                          String                          @id @default(cuid())
  name                        String
  plan                        String                          @default("Production")
  members                     WorkspaceMember[]
  documents                   Document[]
  extractionJobs              ExtractionJob[]
  topicDiscoveryJobs          TopicDiscoveryJob[]
  knowledgeAuthoringRuns      KnowledgeAuthoringRun[]
  ragIndexJobs                RagIndexJob[]
  topicRecords                TopicRecord[]
  activityEvents              ActivityEvent[]
  llmSetting                  WorkspaceLlmSetting?
  chatSessions                ChatSession[]
  okfConceptLifecycles        OkfConceptLifecycle[]
  knowledgeBundles            KnowledgeBundle[]
  bundleDeletionAudits        BundleDeletionAudit[]
  okfConceptEmbeddings        OkfConceptEmbedding[]
  okfEmbeddingJobs            OkfConceptEmbeddingJob[]
  ragRerankDailyUsage         RagRerankDailyUsage[]
  knowledgeGaps               KnowledgeGap[]
  retrievalTriggerProposals   OkfRetrievalTriggerProposal[]
  bulkTopicApprovalRuns       BulkTopicApprovalRun[]
  documentDeletionJobs        DocumentDeletionJob[]
  knowledgeBundleDeletionJobs KnowledgeBundleDeletionJob[]
  documentUploadBatches       DocumentUploadBatch[]
  documentUploadSessions      DocumentUploadSession[]
  canonicalEntities           CanonicalEntity[]
  entityCandidates            EntityCandidate[]
  entityOccurrences           EntityOccurrence[]
  entityExtractionJobs        EntityExtractionJob[]
  entityExpansionRuns         EntityExpansionRun[]
  entityRelationCandidates    EntityRelationCandidate[]
  topicExpansionRuns          TopicExpansionRun[]
  topicExpansionResearchJobs  TopicExpansionResearchJob[]
  topicExpansionProposals     TopicExpansionProposal[]
  topicExpansionBatches       TopicExpansionEnrichmentBatch[]
  topicEnrichmentJobs         TopicEnrichmentJob[]
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
}

model RagRerankDailyUsage {
  id          String    @id @default(cuid())
  workspaceId String
  usageDate   String
  calls       Int       @default(0)
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, usageDate])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
}

model WorkspaceLlmSetting {
  workspaceId     String    @id
  provider        String    @default("anthropic")
  encryptedApiKey String?
  updatedAt       DateTime  @default(now()) @updatedAt
  updatedBy       String?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Document {
  id                       String                         @id @default(cuid())
  workspaceId              String
  knowledgeBundleId        String?
  title                    String
  fileType                 String
  size                     String
  sizeBytes                Int
  status                   String
  tags                     String[]
  updatedLabel             String
  owner                    String
  sourceType               String
  pages                    Int                            @default(0)
  description              String                         @default("")
  subjectFamily            String?
  documentType             String?
  classificationCode       String?
  effectivity              String?
  sourceAuthority          String?
  revision                 String?
  deletedAt                DateTime?
  deletedBy                String?
  deleteReason             String?                        @db.Text
  ragStatus                String                         @default("not_indexed")
  ragIndexVersion          Int                            @default(0)
  originalFilename         String?
  contentSha256            String?
  inspectionStatus         String                         @default("not_started")
  inspectionWarnings       String[]                       @default([])
  inspectedAt              DateTime?
  ocrPageCount             Int                            @default(0)
  unreadablePageNumbers    Int[]                          @default([])
  mimeType                 String
  workspace                Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeBundle          KnowledgeBundle?               @relation(fields: [knowledgeBundleId], references: [id], onDelete: SetNull)
  customProperties         DocumentCustomProperty[]
  objects                  DocumentObject[]
  extractionJobs           ExtractionJob[]
  topicDiscoveryJobs       TopicDiscoveryJob[]
  knowledgeAuthoringRuns   KnowledgeAuthoringRun[]
  ragIndexJobs             RagIndexJob[]
  ragChunks                RagChunk[]
  extractedPages           ExtractedPage[]
  extractionLogs           ExtractionLog[]
  topicRecords             TopicRecord[]
  activityEvents           ActivityEvent[]
  bulkApprovalItems        BulkTopicApprovalItem[]
  processingCheckpoints    DocumentProcessingCheckpoint[]
  topicDiscoveryWindows    TopicDiscoveryWindow[]
  crawlerCandidates        GroundedCrawlerCandidate[]
  entityCandidates         EntityCandidate[]
  entityOccurrences        EntityOccurrence[]
  entityExtractionJobs     EntityExtractionJob[]
  entityRelationCandidates EntityRelationCandidate[]
  topicExpansionEvidence   TopicExpansionEvidence[]
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  topicExpansionProposals  TopicExpansionProposal[]

  @@index([workspaceId, updatedAt])
  @@index([knowledgeBundleId, updatedAt])
  @@index([contentSha256])
}

model KnowledgeBundle {
  id                         String                          @id @default(cuid())
  workspaceId                String
  name                       String
  slug                       String
  description                String                          @default("") @db.Text
  status                     String                          @default("active")
  okfVersion                 String                          @default("0.1")
  activeProfileVersionId     String?                         @unique
  createdBy                  String
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  workspace                  Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activeProfileVersion       KnowledgeBundleProfileVersion?  @relation("ActiveBundleProfile", fields: [activeProfileVersionId], references: [id], onDelete: SetNull)
  profileVersions            KnowledgeBundleProfileVersion[] @relation("BundleProfileVersions")
  documents                  Document[]
  topics                     TopicRecord[]
  lifecycles                 OkfConceptLifecycle[]
  coverageLinks              OkfConceptChunkLink[]
  primaryChatSessions        ChatSession[]                   @relation("PrimaryChatBundle")
  chatSessionSelections      ChatSessionKnowledgeBundle[]
  relationCandidates         OkfRelationCandidate[]
  relationDiscoveryRuns      OkfRelationDiscoveryRun[]
  authoringRuns              KnowledgeAuthoringRun[]
  conceptEmbeddings          OkfConceptEmbedding[]
  conceptEmbeddingJobs       OkfConceptEmbeddingJob[]
  knowledgeGaps              KnowledgeGap[]
  retrievalTriggerProposals  OkfRetrievalTriggerProposal[]
  bulkTopicApprovalRuns      BulkTopicApprovalRun[]
  documentDeletionJobs       DocumentDeletionJob[]
  uploadBatches              DocumentUploadBatch[]
  uploadSessions             DocumentUploadSession[]
  entityCandidates           EntityCandidate[]
  entityOccurrences          EntityOccurrence[]
  entityExtractionJobs       EntityExtractionJob[]
  entityClassifications      EntityBundleClassification[]
  entityTopicLinks           EntityTopicLink[]
  entityExpansionRuns        EntityExpansionRun[]
  entityRelationCandidates   EntityRelationCandidate[]
  topicExpansionRuns         TopicExpansionRun[]
  topicExpansionResearchJobs TopicExpansionResearchJob[]
  topicExpansionProposals    TopicExpansionProposal[]
  topicExpansionBatches      TopicExpansionEnrichmentBatch[]
  topicEnrichmentJobs        TopicEnrichmentJob[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
}

model KnowledgeBundleProfileVersion {
  id              String           @id @default(cuid())
  bundleId        String
  version         Int
  status          String           @default("draft")
  templateId      String
  schema          Json
  createdBy       String
  activatedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bundle          KnowledgeBundle  @relation("BundleProfileVersions", fields: [bundleId], references: [id], onDelete: Cascade)
  activeForBundle KnowledgeBundle? @relation("ActiveBundleProfile")

  @@unique([bundleId, version])
  @@index([bundleId, status])
}

model OkfRelationCandidate {
  id                         String                           @id @default(cuid())
  workspaceId                String
  knowledgeBundleId          String
  sourceFile                 String
  targetFile                 String
  relation                   String
  reason                     String                           @db.Text
  signals                    Json                             @default("[]")
  status                     String                           @default("pending")
  discoveryRunId             String?
  discoveryVersion           String                           @default("deterministic-v2")
  verificationStatus         String                           @default("legacy")
  verificationProvider       String?
  verificationModel          String?
  verificationRelation       String?
  verificationDirection      String?
  verificationEvidenceQuote  String?                          @db.Text
  verificationConfidence     Float?
  verificationRationale      String?                          @db.Text
  verificationError          String?                          @db.Text
  verifierVersion            String?
  sourceContentHash          String?
  targetContentHash          String?
  evidenceChunkIds           String[]                         @default([])
  evidencePageNumbers        Int[]                            @default([])
  evidenceSourceQuote        String?                          @db.Text
  targetAnchor               String?
  targetResolution           String?
  requestedDirection         String?
  authoringRunId             String?
  automaticApprovalRequested Boolean                          @default(false)
  automaticApprovalActor     String?
  automaticApprovalError     String?                          @db.Text
  publishedReviewStatus      String?
  publishedReviewFlaggedAt   DateTime?
  publishedSourceFile        String?
  publishedTargetFile        String?
  publishedRelation          String?
  publishedReason            String?                          @db.Text
  verifiedAt                 DateTime?
  reviewedBy                 String?
  reviewedAt                 DateTime?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  bundle                     KnowledgeBundle                  @relation(fields: [knowledgeBundleId], references: [id], onDelete: Cascade)
  discoveryRun               OkfRelationDiscoveryRun?         @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)
  authoringRun               KnowledgeAuthoringRun?           @relation(fields: [authoringRunId], references: [id], onDelete: SetNull)
  verificationAttempts       OkfRelationVerificationAttempt[]
  entityRelationCandidate    EntityRelationCandidate?

  @@unique([knowledgeBundleId, sourceFile, targetFile, relation])
  @@index([workspaceId, knowledgeBundleId, status])
  @@index([knowledgeBundleId, verificationStatus])
  @@index([knowledgeBundleId, publishedReviewStatus])
  @@index([authoringRunId, automaticApprovalRequested])
}

model OkfRelationDiscoveryRun {
  id                   String                 @id @default(cuid())
  workspaceId          String
  knowledgeBundleId    String
  requestedBy          String
  status               String                 @default("running")
  totalCandidates      Int                    @default(0)
  proposedCount        Int                    @default(0)
  skippedExistingCount Int                    @default(0)
  suppressedCount      Int                    @default(0)
  warningCount         Int                    @default(0)
  queuedCount          Int                    @default(0)
  runningCount         Int                    @default(0)
  confirmedCount       Int                    @default(0)
  filteredCount        Int                    @default(0)
  failedCount          Int                    @default(0)
  startedAt            DateTime               @default(now())
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  bundle               KnowledgeBundle        @relation(fields: [knowledgeBundleId], references: [id], onDelete: Cascade)
  candidates           OkfRelationCandidate[]

  @@index([workspaceId, knowledgeBundleId, status])
}

model OkfRelationVerificationAttempt {
  id           String               @id @default(cuid())
  candidateId  String
  provider     String?
  model        String?
  promptSent   String               @db.Text
  rawResponse  String?              @db.Text
  result       Json?
  succeeded    Boolean              @default(false)
  errorMessage String?              @db.Text
  createdAt    DateTime             @default(now())
  candidate    OkfRelationCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}

model KnowledgeAuthoringRun {
  id                               String                         @id @default(cuid())
  workspaceId                      String
  knowledgeBundleId                String
  documentId                       String
  requestedBy                      String?
  profileVersion                   Int                            @default(1)
  automaticTopicApprovalEnabled    Boolean                        @default(false)
  automaticRelationApprovalEnabled Boolean                        @default(false)
  status                           String                         @default("queued")
  currentStage                     String                         @default("metadata_discovery")
  completedStages                  String[]                       @default([])
  estimatedInputTokens             Int                            @default(0)
  costEstimate                     Json                           @default("{}")
  enrichmentCandidateCount         Int                            @default(0)
  validationResults                Json                           @default("[]")
  relationSuggestions              Json                           @default("[]")
  errorCode                        String?
  errorMessage                     String?
  costConfirmedAt                  DateTime?
  costConfirmedBy                  String?
  startedAt                        DateTime?
  readyAt                          DateTime?
  completedAt                      DateTime?
  createdAt                        DateTime                       @default(now())
  updatedAt                        DateTime                       @updatedAt
  workspace                        Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeBundle                  KnowledgeBundle                @relation(fields: [knowledgeBundleId], references: [id], onDelete: Cascade)
  document                         Document                       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  stageAudits                      KnowledgeAuthoringStageAudit[]
  metadataProposals                DocumentMetadataProposal[]
  automaticApprovalRun             BulkTopicApprovalRun?
  relationCandidates               OkfRelationCandidate[]

  @@index([workspaceId, status, createdAt])
  @@index([documentId, createdAt])
}

model KnowledgeAuthoringStageAudit {
  id           String                @id @default(cuid())
  runId        String
  stage        String
  status       String
  attempt      Int                   @default(1)
  provider     String?
  model        String?
  promptSent   String?               @db.Text
  rawResponse  String?               @db.Text
  errorMessage String?
  startedAt    DateTime              @default(now())
  completedAt  DateTime?
  createdAt    DateTime              @default(now())
  run          KnowledgeAuthoringRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model DocumentMetadataProposal {
  id             String                @id @default(cuid())
  runId          String
  documentId     String
  workspaceId    String
  proposedValues Json
  previousValues Json
  appliedValues  Json
  rationale      Json                  @default("{}")
  provider       String
  model          String
  status         String                @default("applied")
  createdAt      DateTime              @default(now())
  undoneAt       DateTime?
  undoneBy       String?
  run            KnowledgeAuthoringRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([documentId, createdAt])
}

model BundleDeletionAudit {
  id             String    @id @default(cuid())
  workspaceId    String
  bundleId       String
  bundleName     String
  deletedBy      String
  deletedAt      DateTime  @default(now())
  deletionCounts Json
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, deletedAt])
}

model KnowledgeBundleDeletionJob {
  id           String    @id @default(cuid())
  workspaceId  String
  bundleId     String    @unique
  bundleName   String
  requestedBy  String
  status       String    @default("queued")
  manifest     Json
  attempts     Int       @default(0)
  errorCode    String?
  errorMessage String?   @db.Text
  queuedAt     DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, queuedAt])
}

model DocumentDeletionJob {
  id                String           @id @default(cuid())
  workspaceId       String
  knowledgeBundleId String?
  documentId        String           @unique
  documentTitle     String
  requestedBy       String
  status            String           @default("queued")
  manifest          Json
  attempts          Int              @default(0)
  errorCode         String?
  errorMessage      String?          @db.Text
  queuedAt          DateTime         @default(now())
  startedAt         DateTime?
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeBundle   KnowledgeBundle? @relation(fields: [knowledgeBundleId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, queuedAt])
  @@index([knowledgeBundleId, status])
}

model DocumentCustomProperty {
  id         String   @id @default(cuid())
  documentId String
  key        String
  value      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentObject {
  id          String   @id @default(cuid())
  workspaceId String
  documentId  String
  kind        String
  objectKey   String   @unique
  bucket      String
  contentType String
  sizeBytes   Int
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([workspaceId, documentId, kind])
}

model DocumentUploadBatch {
  id                String                  @id @default(cuid())
  workspaceId       String
  knowledgeBundleId String
  requestedBy       String
  status            String                  @default("initiated")
  totalFiles        Int
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeBundle   KnowledgeBundle         @relation(fields: [knowledgeBundleId], references: [id], onDelete: Cascade)
  sessions          DocumentUploadSession[]

  @@index([workspaceId, status, createdAt])
  @@index([knowledgeBundleId, status, createdAt])
}

model DocumentUploadSession {
  id                String               @id @default(cuid())
  batchId           String?
  batchOrdinal      Int?
  workspaceId       String
  knowledgeBundleId String
  requestedBy       String
  documentId        String               @unique
  objectKey         String               @unique
  originalFilename  String
  contentType       String
  expectedSizeBytes Int
  metadata          Json
  status            String               @default("initiated")
  errorCode         String?
  expiresAt         DateTime
  finalizedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  batch             DocumentUploadBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeBundle   KnowledgeBundle      @relation(fields: [knowledgeBundleId], references: [id], onDelete: Cascade)

  @@unique([batchId, batchOrdinal])
  @@index([workspaceId, status, expiresAt])
  @@index([knowledgeBundleId, status])
  @@index([batchId, status])
}

model ExtractionJob {
  id           String                         @id @default(cuid())
  workspaceId  String
  documentId   String
  status       String
  attempts     Int                            @default(0)
  errorCode    String?
  errorMessage String?
  queuedAt     DateTime                       @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  workspace    Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document     Document                       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  checkpoints  DocumentProcessingCheckpoint[]

  @@index([status, queuedAt])
  @@index([workspaceId, documentId])
}

model DocumentProcessingCheckpoint {
  id          String        @id @default(cuid())
  jobId       String
  documentId  String
  stage       String
  batchIndex  Int
  pageStart   Int
  pageEnd     Int
  status      String        @default("queued")
  attempts    Int           @default(0)
  outputHash  String?
  outputKey   String?
  errorCode   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  job         ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  document    Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([jobId, stage, batchIndex])
  @@index([documentId, stage, status])
}

model TopicDiscoveryJob {
  id                   String                 @id @default(cuid())
  workspaceId          String
  documentId           String
  status               String                 @default("queued")
  provider             String?
  model                String?
  attempts             Int                    @default(0)
  completedWindows     Int                    @default(0)
  totalWindows         Int                    @default(0)
  estimatedInputTokens Int                    @default(0)
  errorCode            String?
  errorMessage         String?
  queuedAt             DateTime               @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document             Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  audits               TopicDiscoveryAudit[]
  windows              TopicDiscoveryWindow[]

  @@index([status, queuedAt])
  @@index([workspaceId, documentId, queuedAt])
}

model TopicDiscoveryWindow {
  id          String            @id @default(cuid())
  jobId       String
  documentId  String
  ordinal     Int
  pageStart   Int
  pageEnd     Int
  contentHash String
  inputTokens Int
  status      String            @default("queued")
  attempts    Int               @default(0)
  candidates  Json              @default("[]")
  errorCode   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  job         TopicDiscoveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  document    Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([jobId, ordinal])
  @@index([documentId, status])
}

model GroundedCrawlerCandidate {
  id               String   @id @default(cuid())
  documentId       String
  seed             String
  seedHash         String
  candidateType    String
  payload          Json
  evidenceChunkIds String[]
  sourcePages      Int[]
  evidenceQuote    String   @db.Text
  status           String   @default("validated")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, seedHash, candidateType, evidenceQuote])
  @@index([documentId, status])
}

model TopicDiscoveryAudit {
  id            String            @id @default(cuid())
  jobId         String
  stage         String
  windowOrdinal Int?
  provider      String
  model         String
  promptSent    String            @db.Text
  rawResponse   String            @db.Text
  inputTokens   Int               @default(0)
  outputTokens  Int               @default(0)
  succeeded     Boolean
  errorMessage  String?
  createdAt     DateTime          @default(now())
  job           TopicDiscoveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model ExtractedPage {
  id               String   @id @default(cuid())
  workspaceId      String
  documentId       String
  pageNumber       Int
  text             String   @db.Text
  tables           Json
  imageCount       Int
  charCount        Int
  extractionMethod String   @default("digital")
  ocrConfidence    Float?
  warningCodes     String[] @default([])
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@index([workspaceId, documentId])
}

model ExtractionLog {
  id          String   @id @default(cuid())
  workspaceId String
  documentId  String
  jobId       String?
  timestamp   DateTime @default(now())
  level       String
  message     String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, documentId, timestamp])
}

model RagIndexJob {
  id               String                    @id @default(cuid())
  workspaceId      String
  documentId       String
  extractionJobId  String?
  status           String
  indexVersion     Int
  tokenEstimate    Int                       @default(0)
  attempts         Int                       @default(0)
  errorCode        String?
  errorMessage     String?
  queuedAt         DateTime                  @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document         Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks           RagChunk[]
  batchCheckpoints RagIndexBatchCheckpoint[]

  @@index([status, queuedAt])
  @@index([workspaceId, documentId, status])
}

model RagIndexBatchCheckpoint {
  id          String      @id @default(cuid())
  indexJobId  String
  batchIndex  Int
  chunkStart  Int
  chunkEnd    Int
  tokenCount  Int
  status      String      @default("queued")
  attempts    Int         @default(0)
  errorCode   String?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  indexJob    RagIndexJob @relation(fields: [indexJobId], references: [id], onDelete: Cascade)

  @@unique([indexJobId, batchIndex])
  @@index([status, updatedAt])
}

model RagChunk {
  id                     String                   @id
  workspaceId            String
  documentId             String
  indexJobId             String
  indexVersion           Int
  chunkingStrategyId     String?
  chunkOrdinal           Int
  text                   String                   @db.Text
