  baselineFingerprint                String?
  baselineTitle                      String?
  baselineSummary                    String?     @db.Text
  baselineBody                       String?     @db.Text
  baselineProposedSourcePageNumbers  Int[]       @default([])
  candidateTitle                     String?
  candidateSummary                   String?     @db.Text
  candidateBody                      String?     @db.Text
  candidateProposedSourcePageNumbers Int[]       @default([])
  diff                               Json        @default("{}")
  disposition                        String      @default("applied")
  resolvedAt                         DateTime?
  resolvedBy                         String?
  topic                              TopicRecord @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
  @@index([topicId, disposition, createdAt])
}

model ActivityEvent {
  id            String    @id @default(cuid())
  workspaceId   String
  documentId    String?
  label         String
  documentTitle String
  timestamp     String
  status        String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model ChatSession {
  id                       String                       @id @default(cuid())
  workspaceId              String
  primaryKnowledgeBundleId String?                      @map("knowledgeBundleId")
  userId                   String
  title                    String                       @default("New chat")
  scopeVersion             Int                          @default(1)
  workspace                Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  primaryKnowledgeBundle   KnowledgeBundle?             @relation("PrimaryChatBundle", fields: [primaryKnowledgeBundleId], references: [id], onDelete: SetNull)
  knowledgeBundles         ChatSessionKnowledgeBundle[]
  messages                 ChatMessage[]
  knowledgeGaps            KnowledgeGap[]
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([primaryKnowledgeBundleId, updatedAt])
}

model ChatSessionKnowledgeBundle {
  sessionId         String
  knowledgeBundleId String
  position          Int
  selectedBy        String
  selectedAt        DateTime        @default(now())
  session           ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  knowledgeBundle   KnowledgeBundle @relation(fields: [knowledgeBundleId], references: [id], onDelete: Cascade)

  @@id([sessionId, knowledgeBundleId])
  @@unique([sessionId, position])
  @@index([knowledgeBundleId, sessionId])
}

model ChatMessage {
  id                 String        @id @default(cuid())
  workspaceId        String
  sessionId          String
  role               String
  content            String        @db.Text
  citations          Json          @default("[]")
  trace              Json?
  knowledgeBundleIds String[]      @default([])
  scopeVersion       Int           @default(1)
  session            ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  knowledgeGap       KnowledgeGap?
  createdAt          DateTime      @default(now())

  @@index([workspaceId, sessionId, createdAt])
}

model KnowledgeGap {
  id                         String                        @id @default(cuid())
  workspaceId                String
  primaryKnowledgeBundleId   String?                       @map("knowledgeBundleId")
  searchedKnowledgeBundleIds String[]                      @default([])
  chatSessionId              String
  assistantMessageId         String                        @unique
  question                   String                        @db.Text
  retrievalQuery             String                        @db.Text
  route                      String
  finalEvidenceStatus        String                        @default("no_evidence")
  reason                     String                        @db.Text
  searchedSources            String[]
  status                     String                        @default("open")
  workspace                  Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  primaryKnowledgeBundle     KnowledgeBundle?              @relation(fields: [primaryKnowledgeBundleId], references: [id], onDelete: SetNull)
  chatSession                ChatSession                   @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  assistantMessage           ChatMessage                   @relation(fields: [assistantMessageId], references: [id], onDelete: Cascade)
  retrievalTriggerProposals  OkfRetrievalTriggerProposal[]
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  @@index([workspaceId, primaryKnowledgeBundleId, status, createdAt])
}

model OkfRetrievalTriggerProposal {
  id                String          @id @default(cuid())
  workspaceId       String
  knowledgeBundleId String
  knowledgeGapId    String
  fingerprint       String
  targetFilePath    String
  targetTitle       String
  targetContentHash String
  suggestedTerms    String[]
  approvedTerms     String[]        @default([])
  matchReason       String          @db.Text
  status            String          @default("pending")
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeBundle   KnowledgeBundle @relation(fields: [knowledgeBundleId], references: [id], onDelete: Cascade)
  knowledgeGap      KnowledgeGap    @relation(fields: [knowledgeGapId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, knowledgeBundleId, fingerprint])
  @@index([workspaceId, knowledgeBundleId, status, createdAt])
  @@index([knowledgeGapId, status])
}
